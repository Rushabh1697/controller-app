# Node
node_modules/
website/node_modules/

# Python
__pycache__/
*.py[cod]
*.pyo

# PyInstaller build artifacts — keep only Release/ which is the intended download location
build/
dist/
*.spec.bak

# PyInstaller spec files (keep GyroPadHost-Windows.spec as canonical; ignore duplicates)
GyroPadHost.spec

# GyroPad generated config (not source — stored in %APPDATA%\GyroPad)
src/ui/mapping.json

# Dev artifacts — sensor dumps from ADB diagnostics
sensor_dump*.txt

# Website binaries — served from Release/ via GitHub raw URLs, not from website/assets/
website/assets/*.apk
website/assets/*.exe

# Flutter
companion_app/.dart_tool/
companion_app/build/
companion_app/.flutter-plugins
companion_app/.flutter-plugins-dependencies

# IDE
.idea/
*.iml
.vscode/
.DS_Store
